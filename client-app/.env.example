# =============================================
# Harness App Environment Variables
# Copy this to .env and update values
# =============================================

VITE_APP_NAME=Harness
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development

# API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI Provider: openai | gemini | anthropic
VITE_AI_PROVIDER=openai
VITE_AI_API_KEY=your_ai_api_key_here
VITE_AI_MODEL=gpt-4o

# Auth
VITE_AUTH_TOKEN_KEY=harness_auth_token
VITE_REFRESH_TOKEN_KEY=harness_refresh_token

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_ANALYTICS=false
